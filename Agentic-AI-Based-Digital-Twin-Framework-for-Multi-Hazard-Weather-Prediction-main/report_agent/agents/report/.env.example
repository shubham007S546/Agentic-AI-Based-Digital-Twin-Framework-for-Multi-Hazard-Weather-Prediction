# All optional -- report generation (PDF/Excel/JSON/charts) works with zero
# external dependencies. Set these to pull real data from the other agents.

WEATHER_AGENT_URL=http://localhost:8001
PREDICTION_AGENT_URL=http://localhost:8002
ALERT_AGENT_URL=http://localhost:8003
DIGITAL_TWIN_AGENT_URL=http://localhost:8004
AGENT_REQUEST_TIMEOUT_SECONDS=20

REPORTS_OUTPUT_DIR=reports_output
REPORT_LOG_PATH=logs/reports.jsonl
REPORT_AGENT_LOG_DIR=logs
REDIS_URL=

# Optional -- richer LLM-generated narrative summaries instead of the
# rule-based sentence-joining fallback.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
