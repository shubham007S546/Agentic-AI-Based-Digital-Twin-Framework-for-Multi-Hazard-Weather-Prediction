# Everything here is optional -- Open-Meteo (the one real provider) needs no key.

# Optional. If set, richer LLM-generated summaries via Groq instead of a
# deterministic template. Get a free key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional. If set, the result cache persists in Redis instead of an
# in-process dict (needed for a shared cache across multiple instances,
# or to survive restarts).
REDIS_URL=

# Optional.
WEATHER_CACHE_TTL_SECONDS=1800
WEATHER_AGENT_LOG_DIR=logs
WEATHER_HTTP_TIMEOUT_SECONDS=15
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
