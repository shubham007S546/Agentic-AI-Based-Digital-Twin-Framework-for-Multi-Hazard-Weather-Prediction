# All optional -- the agent works out of the box with rule-based scoring
# and stubbed notifications.

# Sibling agents this one calls for real data.
PREDICTION_AGENT_URL=http://localhost:8002
WEATHER_AGENT_URL=http://localhost:8001
AGENT_REQUEST_TIMEOUT_SECONDS=20

# ReliefWeb: real, public API. appname just identifies your app to them
# (not a secret) -- change it to something meaningful if you like.
RELIEFWEB_BASE_URL=https://api.reliefweb.int/v2/reports
RELIEFWEB_APPNAME=himachal-digital-twin
RELIEFWEB_COUNTRY_ISO3=IND

# Severity thresholds on the composite 0-1 risk score.
RISK_RED_THRESHOLD=0.85
RISK_ORANGE_THRESHOLD=0.60
RISK_YELLOW_THRESHOLD=0.35

# Rainfall (mm) that alone forces at least Orange severity.
CLOUDBURST_MM_FLOOR=100.0

# Severities at/above this auto-escalate to authorities: green|yellow|orange|red
ESCALATION_SEVERITY_FLOOR=orange

# Comma-separated: email,sms,push,whatsapp -- all stubbed until you add
# real provider credentials in escalation.py
NOTIFICATION_CHANNELS=email

ALERT_LOG_PATH=logs/alerts.jsonl
ALERT_RISK_AGENT_LOG_DIR=logs
REDIS_URL=

# Optional -- richer LLM-generated alert descriptions instead of the template.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
