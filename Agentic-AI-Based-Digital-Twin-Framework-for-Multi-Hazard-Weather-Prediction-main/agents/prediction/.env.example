# ---------------------------------------------------------------------------
# Required for real inference
# ---------------------------------------------------------------------------

# Path to your machine_learning_module/ folder (so this agent can import
# its models package). Adjust to wherever this agent sits relative to it.
ML_MODULE_PATH=../../machine_learning_module

# Your best model from the comparison: log1p LightGBM (test R²=0.216).
RAINFALL_MODEL_PATH=machine_learning_module/artifacts/lightgbm/step2_log1p_lgbm/model.joblib
RAINFALL_MODEL_ALGO=lightgbm
RAINFALL_TARGET_TRANSFORM=log1p

# Path to ml_ready/scaler_params.csv -- REQUIRED for correct predictions,
# unless your model was trained on raw (unscaled) features. If this is
# unset, features are passed through UNSCALED and predictions will likely
# be wrong -- the agent will warn about this loudly in its response `notes`.
SCALER_PARAMS_PATH=ml_ready/scaler_params.csv

# ---------------------------------------------------------------------------
# Optional -- only if/when you've trained these
# ---------------------------------------------------------------------------
CLOUDBURST_MODEL_PATH=
CLOUDBURST_MODEL_ALGO=xgboost

LANDSLIDE_MODEL_PATH=
LANDSLIDE_MODEL_ALGO=xgboost

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
CLOUDBURST_THRESHOLD_MM=100.0
PREDICTION_LOG_PATH=logs/predictions.jsonl
PREDICTION_AGENT_LOG_DIR=logs
REDIS_URL=
