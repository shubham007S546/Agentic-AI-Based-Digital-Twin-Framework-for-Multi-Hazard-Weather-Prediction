# Orchestrator Agent environment configuration
# ─────────────────────────────────────────────
# All optional — the orchestrator works without any of these,
# but real LLM routing and correct downstream URLs need them.

# ── Downstream agent URLs (default: all on localhost) ─────────────────────────
# When running via docker-compose.agents.yml these are set automatically
# to Docker internal DNS names (e.g. http://weather_analysis_agent:8001).
WEATHER_AGENT_URL=http://localhost:8001
PREDICTION_AGENT_URL=http://localhost:8002
ALERT_AGENT_URL=http://localhost:8003
DIGITAL_TWIN_AGENT_URL=http://localhost:8004
REPORT_AGENT_URL=http://localhost:8006

# ── LLM backend (Groq — free tier available at console.groq.com) ──────────────
# If unset, the orchestrator falls back to deterministic rule-based routing.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Redis (optional — only needed for shared conversation memory) ──────────────
REDIS_URL=

# ── Logging ───────────────────────────────────────────────────────────────────
ORCHESTRATOR_LOG_DIR=logs
