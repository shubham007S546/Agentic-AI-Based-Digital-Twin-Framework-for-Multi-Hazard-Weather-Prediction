# All optional -- the agent runs real hydrology/landslide formulas with
# documented default assumptions if your actual GIS layers aren't found.

# Path to your digital_twin/ folder (for boundary GeoJSON + infrastructure
# layers). Adjust to wherever this agent sits relative to it.
DIGITAL_TWIN_DIR=../digital_twin

# Hydrology (Rational Method) defaults -- see hydrology_model.py for the
# reasoning. Replace with calibrated values once you have real gauged
# discharge to fit against.
DEFAULT_RUNOFF_COEFFICIENT=0.55
DEFAULT_CATCHMENT_AREA_KM2=50.0
DEFAULT_CHANNEL_CAPACITY_M3S=25.0

# Landslide (Caine 1980 global threshold) defaults -- see landslide_model.py.
CAINE_COEFFICIENT=14.82
CAINE_EXPONENT=-0.39
DEFAULT_SLOPE_CLASS=steep

REDIS_URL=
TWIN_STATE_LOG_PATH=logs/digital_twin_state.jsonl
DIGITAL_TWIN_AGENT_LOG_DIR=logs
