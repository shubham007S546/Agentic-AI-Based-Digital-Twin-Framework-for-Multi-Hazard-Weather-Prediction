# =============================================================================
#  WEATHER TWIN BACKEND — ENVIRONMENT VARIABLES
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to version control.
# =============================================================================

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME="Weather Twin Backend"
APP_VERSION=1.0.0
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=4
APP_RELOAD=false

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
APP_SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_64_output_here
ALLOWED_HOSTS=["localhost","127.0.0.1","0.0.0.0"]
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://weather_user:weather_pass@localhost:5432/weather_twin_db
DATABASE_SYNC_URL=postgresql+psycopg2://weather_user:weather_pass@localhost:5432/weather_twin_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_ECHO=false

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_DB=0
REDIS_CELERY_BROKER_DB=1
REDIS_CELERY_RESULT_DB=2
REDIS_RATE_LIMIT_DB=3
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT=5
REDIS_CONNECT_TIMEOUT=5

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_TIMEZONE=Asia/Kolkata
CELERY_TASK_TRACK_STARTED=true
CELERY_WORKER_CONCURRENCY=4

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET_KEY=CHANGE_ME_another_secure_random_64_byte_hex_string_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=weather-twin-platform
JWT_AUDIENCE=weather-twin-users

# ── MinIO / S3 Object Storage ─────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_USE_SSL=false
MINIO_REGION=us-east-1
MINIO_BUCKET_MODELS=ml-models
MINIO_BUCKET_REPORTS=reports
MINIO_BUCKET_DATASETS=datasets
MINIO_BUCKET_SATELLITE=satellite-data

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=no-reply@weather-twin.ai
SMTP_PASSWORD=CHANGE_ME_smtp_password
EMAIL_FROM_NAME="Weather Twin Platform"
EMAIL_FROM_ADDRESS=no-reply@weather-twin.ai

# ── OpenTelemetry ─────────────────────────────────────────────────────────────
OTEL_ENABLED=true
OTEL_SERVICE_NAME=weather-twin-backend
OTEL_SERVICE_VERSION=1.0.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=prometheus

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_REQUESTS=100
RATE_LIMIT_DEFAULT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_PREDICTION_REQUESTS=30
RATE_LIMIT_PREDICTION_WINDOW_SECONDS=60

# ── Pagination ────────────────────────────────────────────────────────────────
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ── Weather Data Sources ──────────────────────────────────────────────────────
OPENWEATHER_API_KEY=886cd33323a4600331a38bd829e16c5f
OPEN_METEO_BASE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
NASA_EARTHDATA_USERNAME=CHANGE_ME
NASA_EARTHDATA_PASSWORD=CHANGE_ME
NASA_EARTHDATA_TOKEN=CHANGE_ME
CDS_API_KEY=b7fea9da-1b9c-4760-a159-eef0a23b3b16
DATAGOV_API_KEY=CHANGE_ME
WRIS_API_KEY=CHANGE_ME
RELIEFWEB_APPNAME=weather-twin

# ── Districts (Himachal Pradesh focus) ───────────────────────────────────────
ACTIVE_DISTRICTS=mandi,kullu,chamba
DEFAULT_DISTRICT=mandi

# ── Feature Flags ─────────────────────────────────────────────────────────────
FEATURE_AGENTS_ENABLED=true
FEATURE_DIGITAL_TWIN_ENABLED=true
FEATURE_SATELLITE_ENABLED=false
FEATURE_GNN_ENABLED=false
FEATURE_ONNX_ENABLED=true
FEATURE_GPU_ENABLED=false

# ── Model Serving ─────────────────────────────────────────────────────────────
MODEL_BASE_PATH=../saved_models
MODEL_REGISTRY_BACKEND=minio
MODEL_WARM_LOAD_ON_STARTUP=true
MODEL_INFERENCE_TIMEOUT_SECONDS=30
MODEL_MAX_BATCH_SIZE=256

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_TO_FILE=false
LOG_FILE_PATH=logs/backend.log

# ── Prometheus ────────────────────────────────────────────────────────────────
PROMETHEUS_ENABLED=true
PROMETHEUS_METRICS_PATH=/metrics
